# Timeless Environment Configuration
# Copy to .env and fill in values

# Application
ENVIRONMENT=development
PORT=8080
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgres://timeless:timeless@localhost:5432/timeless?sslmode=disable
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-random-64-char-secret-in-production
JWT_EXPIRY=24h
REFRESH_EXPIRY=720h

# Dedicated secret for encrypting integration credentials at rest
# (falls back to JWT_SECRET if unset — fine in development, but the app
# refuses to start in production with ENVIRONMENT=production unless
# this is set explicitly to its own strong, non-placeholder value,
# distinct from JWT_SECRET). See backend/docs/INTEGRATIONS.md.
CREDENTIALS_ENCRYPTION_KEY=
CREDENTIALS_ENCRYPTION_KEY_PREVIOUS=

# OAuth - Notion (create a public integration at notion.so/my-integrations)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Apollo and Zapier have no OAuth app registration for regular customers —
# Apollo connects via a pasted API key, Zapier via a pasted MCP connection
# token, both entered directly in the Integrations page. See
# backend/docs/INTEGRATIONS.md.

# AI Providers (configure at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Storage (MinIO in dev)
S3_ENDPOINT=localhost:9000
S3_BUCKET=timeless
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=debug
LOG_FORMAT=text

# Audit log retention: number of days to keep activity/audit-log rows
# before the worker's daily sweep purges them. 0 (default) disables
# purging — audit history is kept indefinitely until you opt into a
# window that fits your compliance requirements.
AUDIT_LOG_RETENTION_DAYS=0

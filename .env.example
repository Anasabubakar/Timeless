# Timeless Environment Configuration
# Copy to .env and fill in values

# Application
ENVIRONMENT=development
PORT=8080
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgres://timeless:timeless@localhost:5432/timeless?sslmode=disable
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-random-64-char-secret-in-production
JWT_EXPIRY=24h
REFRESH_EXPIRY=720h

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/api/auth/callback/google

# AI Providers (configure at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Storage (MinIO in dev)
S3_ENDPOINT=localhost:9000
S3_BUCKET=timeless
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=debug
LOG_FORMAT=text

# Timeless Backend - Environment Variables for Vercel
# Set these in the Vercel Dashboard under Project Settings > Environment Variables

# Required. With ENVIRONMENT=production (as below), the app refuses to
# start unless JWT_SECRET is a real random value (32+ chars, not this
# placeholder) — generate one with `openssl rand -hex 32`.
DATABASE_URL=postgresql://user:pass@host:5432/timeless?sslmode=require
JWT_SECRET=your-jwt-secret-here

# Required in production (see above) — CREDENTIALS_ENCRYPTION_KEY must be
# set explicitly and differ from JWT_SECRET; leaving it unset silently
# falls back to JWT_SECRET, which is fine in development but means one
# leaked secret would compromise both token signing and every stored
# OAuth token/integration credential in production.
CREDENTIALS_ENCRYPTION_KEY=
# Comma-separated retired encryption secrets, oldest first. Add the old
# value here (and set a new CREDENTIALS_ENCRYPTION_KEY) to rotate keys
# without breaking decryption of already-stored credentials, then call
# POST /api/v1/integrations/rotate-credentials to re-encrypt them under the
# new key.
CREDENTIALS_ENCRYPTION_KEY_PREVIOUS=

# Frontend URL for CORS (your frontend Vercel deployment URL)
FRONTEND_URL=https://timeless.vercel.app

# Redis (use Upstash Redis for Vercel)
REDIS_URL=redis://default:password@host:6379

# Environment
ENVIRONMENT=production

# Optional: number of days to keep activity/audit-log rows before the
# worker's daily sweep purges them. 0 (default) disables purging.
AUDIT_LOG_RETENTION_DAYS=0

# Optional: set to true to process background jobs (integration syncs,
# webhook deliveries, periodic resync) inside the API process itself,
# instead of requiring a separately deployed `cmd/worker` service. Use
# this if you're running a single web service and don't want to pay for
# a second one — set it on that one service, not on cmd/worker (which
# doesn't read this var at all; it always runs the job consumer).
# Leave unset/false if you do run a dedicated worker service.
EMBED_WORKER=false

# Optional - AI Providers
# Default completion chain, in priority order: Gemini -> Groq -> Nvidia -> OpenRouter.
# Only keys you set are used; if a hop errors, the next one is tried automatically.
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional - Email
# Pick ONE provider below. SMTP_FROM/SMTP_FROM_NAME are the sending
# address used no matter which provider is active — set them even if
# you're using SendGrid or Resend, not just for SMTP itself. If none of
# SMTP_HOST/SENDGRID_API_KEY/RESEND_API_KEY are set, emails (invitations,
# verification, password reset) are silently not sent — the underlying
# action still succeeds, nothing surfaces the missing email to the user.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Timeless
SENDGRID_API_KEY=
# Resend (https://resend.com). Note: their shared onboarding@resend.dev
# sending address only delivers to the account owner's own verified
# email — for sending to arbitrary invited teammates in production, you
# need a verified domain in Resend and SMTP_FROM set to an address on it.
RESEND_API_KEY=

# Optional - Object Storage (S3-compatible)
S3_ENDPOINT=
S3_BUCKET=timeless
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=true

# OAuth for integrations (set to enable "Connect with OAuth" buttons)
# Zapier has no third-party OAuth app registration — it connects via a
# personal MCP Server URL pasted in on the Connect Zapier step instead.
API_PUBLIC_URL=http://localhost:8080
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
APOLLO_CLIENT_ID=
APOLLO_CLIENT_SECRET=

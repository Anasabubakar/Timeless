# Timeless Backend - Environment Variables for Vercel
# Set these in the Vercel Dashboard under Project Settings > Environment Variables

# Required
DATABASE_URL=postgresql://user:pass@host:5432/timeless?sslmode=require
JWT_SECRET=your-jwt-secret-here

# Frontend URL for CORS (your frontend Vercel deployment URL)
FRONTEND_URL=https://timeless.vercel.app

# Redis (use Upstash Redis for Vercel)
REDIS_URL=redis://default:password@host:6379

# Environment
ENVIRONMENT=production

# Optional - AI Providers
# Default completion chain, in priority order: Gemini -> Groq -> Nvidia -> OpenRouter.
# Only keys you set are used; if a hop errors, the next one is tried automatically.
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional - Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SENDGRID_API_KEY=

# Optional - Object Storage (S3-compatible)
S3_ENDPOINT=
S3_BUCKET=timeless
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=true

# OAuth for integrations (set to enable "Connect with OAuth" buttons)
# Zapier has no third-party OAuth app registration — it connects via a
# personal MCP Server URL pasted in on the Connect Zapier step instead.
API_PUBLIC_URL=http://localhost:8080
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
APOLLO_CLIENT_ID=
APOLLO_CLIENT_SECRET=

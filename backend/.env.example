# SponsorOS Backend - Environment Variables for Vercel
# Set these in the Vercel Dashboard under Project Settings > Environment Variables

# Required
DATABASE_URL=postgresql://user:pass@host:5432/sponsoros?sslmode=require
JWT_SECRET=your-jwt-secret-here

# Frontend URL for CORS (your frontend Vercel deployment URL)
FRONTEND_URL=https://sponsoros.vercel.app

# Redis (use Upstash Redis for Vercel)
REDIS_URL=redis://default:password@host:6379

# Environment
ENVIRONMENT=production

# Optional - AI Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional - Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SENDGRID_API_KEY=

# Optional - Object Storage (S3-compatible)
S3_ENDPOINT=
S3_BUCKET=sponsoros
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=true
